source "https://rubygems.org"

# Build the site with the exact same toolchain GitHub Pages uses in
# production, so local previews match what gets deployed.
# Versions: https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# webrick was removed from Ruby's standard library in Ruby 3.0, but
# `jekyll serve` still needs it to run the local web server.
gem "webrick", "~> 1.8"
